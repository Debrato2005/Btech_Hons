{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI for Robotics slide v1",
  "$ref": "#/$defs/slide",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "lectures",
            "assignment_solutions",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "providerFileId": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrievalStatus": {
          "enum": [
            "pending",
            "ready",
            "unavailable"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "pageCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "localPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "assetId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "filename",
        "role",
        "url",
        "providerFileId",
        "retrievalStatus",
        "sha256",
        "pageCount",
        "version",
        "localPath",
        "assetId"
      ],
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "source_pdf",
            "source_page",
            "diagram",
            "font",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "physicalPage": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "mimeType",
        "sha256",
        "alt"
      ],
      "additionalProperties": true
    },
    "visualInspection": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "complete",
            "uncertain"
          ]
        },
        "inspectorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "inspectedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "enum": [
            null,
            "rendered_page",
            "pdf_viewer"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "inspectorId",
        "inspectedAt",
        "method",
        "notes"
      ],
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "physicalPage": {
          "type": "integer",
          "minimum": 1
        },
        "combinedLecturePage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "week": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "lectureId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lectureTitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "lectureRelativePage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "printedSlideNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "printedSlideNumberStatus": {
          "enum": [
            "present",
            "absent",
            "unreadable",
            "unchecked"
          ]
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "disposition": {
          "enum": [
            "unreviewed",
            "examinable",
            "repeated",
            "excluded",
            "unresolved"
          ]
        },
        "exclusionReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "repeatsSlideIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "incrementalChangesChecked": {
          "type": "boolean"
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "assetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "visualInspection": {
          "$ref": "#/$defs/visualInspection"
        }
      },
      "required": [
        "id",
        "sourceId",
        "sourceSha256",
        "physicalPage",
        "combinedLecturePage",
        "week",
        "lectureId",
        "lectureTitle",
        "lectureRelativePage",
        "printedSlideNumber",
        "printedSlideNumberStatus",
        "title",
        "text",
        "disposition",
        "exclusionReason",
        "repeatsSlideIds",
        "incrementalChangesChecked",
        "conceptIds",
        "assetId",
        "visualInspection"
      ],
      "additionalProperties": true
    },
    "concept": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "slideIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "questionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "identified",
            "drafted",
            "verified",
            "flagged"
          ]
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "subtopic": {
          "type": "string",
          "minLength": 1
        },
        "prerequisiteConceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "slideIds",
        "questionIds",
        "status",
        "topic",
        "subtopic",
        "prerequisiteConceptIds"
      ],
      "additionalProperties": true
    },
    "region": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "citation": {
      "type": "object",
      "properties": {
        "slideId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "physicalPage": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "statement",
            "equation",
            "table",
            "figure",
            "code",
            "derivation",
            "other"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "evidenceText": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "explicit",
            "premise",
            "conflict"
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/region"
            }
          ]
        }
      },
      "required": [
        "slideId",
        "sourceId",
        "sourceSha256",
        "physicalPage",
        "kind",
        "locator",
        "evidenceText",
        "role",
        "region"
      ],
      "additionalProperties": true
    },
    "formula": {
      "type": "object",
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "expression",
        "variables",
        "units",
        "assumptions"
      ],
      "additionalProperties": true
    },
    "solution": {
      "type": "object",
      "properties": {
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "optionExplanations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "formulas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formula"
          },
          "minItems": 0
        },
        "simpleExplanation": {
          "type": "string",
          "minLength": 1
        },
        "memoryAid": {
          "type": [
            "string",
            "null"
          ]
        },
        "misconceptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "examTraps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "prerequisiteConceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "justification",
        "optionExplanations",
        "steps",
        "formulas",
        "simpleExplanation",
        "memoryAid",
        "misconceptions",
        "examTraps",
        "prerequisiteConceptIds"
      ],
      "additionalProperties": true
    },
    "variant": {
      "type": "object",
      "properties": {
        "familyId": {
          "type": "string",
          "minLength": 1
        },
        "generatorVersion": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "rounding": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "object"
        }
      },
      "required": [
        "familyId",
        "generatorVersion",
        "seed",
        "parameters",
        "rounding",
        "units"
      ],
      "additionalProperties": true
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "verified",
            "flagged",
            "rejected"
          ]
        },
        "authorId": {
          "type": "string",
          "minLength": 1
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "selectionMode": {
          "enum": [
            "single",
            "multi"
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard",
            "extremely_tricky"
          ]
        },
        "cognitiveSkill": {
          "enum": [
            "recall",
            "conceptual",
            "application",
            "numerical",
            "algorithm",
            "synthesis"
          ]
        },
        "week": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "lectureId": {
          "type": [
            "string",
            "null"
          ]
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "subtopic": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": true
          },
          "minItems": 2
        },
        "correctOptionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 1
        },
        "solution": {
          "$ref": "#/$defs/solution"
        },
        "origin": {
          "enum": [
            "generated",
            "assignment_adapted",
            "assignment_verbatim"
          ]
        },
        "reviewIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "relatedQuestionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "optionCountRationale": {
          "type": "string",
          "minLength": 1
        },
        "revisionAuthors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "version",
        "status",
        "authorId",
        "stem",
        "selectionMode",
        "type",
        "difficulty",
        "cognitiveSkill",
        "week",
        "lectureId",
        "topic",
        "subtopic",
        "tags",
        "conceptIds",
        "assumptions",
        "options",
        "correctOptionIds",
        "citations",
        "solution",
        "origin",
        "reviewIds"
      ],
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "questionVersion": {
          "type": "integer",
          "minimum": 1
        },
        "questionSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "verified",
            "flagged",
            "rejected"
          ]
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "reviewedSlideIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "independentAnswerOptionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "solvedBeforeAnswerSeen": {
          "type": "boolean"
        },
        "checks": {
          "type": "object",
          "properties": {
            "sourceSupport": {
              "type": "boolean"
            },
            "assumptions": {
              "type": "boolean"
            },
            "answerSet": {
              "type": "boolean"
            },
            "distractors": {
              "type": "boolean"
            },
            "calculations": {
              "type": "boolean"
            },
            "figureFidelity": {
              "type": "boolean"
            },
            "explanation": {
              "type": "boolean"
            },
            "difficulty": {
              "type": "boolean"
            },
            "duplication": {
              "type": "boolean"
            }
          },
          "required": [
            "sourceSupport",
            "assumptions",
            "answerSet",
            "distractors",
            "calculations",
            "figureFidelity",
            "explanation",
            "difficulty",
            "duplication"
          ],
          "additionalProperties": true
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "conditionalIntendedOptionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Hypothetical choices after an explicitly stated repair, never substituted for the literal independent answer set."
        },
        "conditionalAnswerAssumption": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "questionId",
        "questionVersion",
        "questionSha256",
        "reviewerId",
        "decision",
        "reviewedAt",
        "sourceVersions",
        "reviewedSlideIds",
        "independentAnswerOptionIds",
        "solvedBeforeAnswerSeen",
        "checks",
        "reasoning",
        "findings"
      ],
      "additionalProperties": true,
      "anyOf": [
        {
          "properties": {
            "decision": {
              "enum": [
                "flagged",
                "rejected"
              ]
            }
          }
        },
        {
          "properties": {
            "decision": {
              "const": "verified"
            },
            "independentAnswerOptionIds": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "learningTool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "questionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "slideIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "learningTools": {
      "type": "object",
      "properties": {
        "formulaSheet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/learningTool"
          },
          "minItems": 0
        },
        "confusionPairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/learningTool"
          },
          "minItems": 0
        },
        "traps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/learningTool"
          },
          "minItems": 0
        },
        "algorithmVisualizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/learningTool"
          },
          "minItems": 0
        },
        "numericalFamilies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/learningTool"
          },
          "minItems": 0
        }
      },
      "required": [
        "formulaSheet",
        "confusionPairs",
        "traps",
        "algorithmVisualizations",
        "numericalFamilies"
      ],
      "additionalProperties": true
    }
  }
}
