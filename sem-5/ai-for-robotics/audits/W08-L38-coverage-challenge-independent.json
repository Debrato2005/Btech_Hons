  "boundedGapClusters": [
    {
      "id": "L38-GAP-family-table-remaining-examples",
      "physicalPages": [
        1177
      ],
      "target": "Extend the family-table task to account for the displayed MCTS-based and PPO examples and their stated family associations/expanded terms, without making every model-based planner learn a model or presenting the introductory categories as universally exclusive.",
      "currentPartialCoverage": [
        "W08-L38-Q022",
        "W08-L38-Q023",
        "W08-L38-Q066"
      ],
      "whyDistinct": "The present table match only checks REINFORCE,DQN,Dyna-Q,A2C; SARSA is separately tested, but the other two named examples are not assessed. Prefer one bounded table extension, not separate trivia questions."
    },
    {
      "id": "L38-GAP-action-table-arm-drone",
      "physicalPages": [
        1187
      ],
      "target": "Extend the discrete/continuous command comparison to the arm joint-label versus torque-in-Nm row and the drone ascend/descend/hover versus three-component thrust-vector row. Explicitly leave the drone-vector units unspecified, as in the source.",
      "currentPartialCoverage": [
        "W08-L38-Q044",
        "W08-L38-Q045"
      ],
      "whyDistinct": "The existing item covers only the mobile wheel-speed row. The remaining rows add command-variable, dimension and unit distinctions; an integrated match can cover them without redundant numerical variants."
    },
    {
      "id": "L38-GAP-illustrated-cnn-action-trace",
      "physicalPages": [
        1180
      ],
      "target": "Extend the existing finite-action architecture item to trace the actual raw-screen→CNN features→Q outputs→selected-action arrow and identify the pictured Action2/RIGHT selection. Scope all literal labels to this illustration, not the valid actions of a real Breakout implementation.",
      "currentPartialCoverage": [
        "W08-L38-Q018",
        "W08-L38-Q025",
        "W08-L38-Q026"
      ],
      "whyDistinct": "The one-pass/vector-output concept is covered, but the actual figure’s selected branch is not assessed. Prefer one integrated diagram extension over a new label-count trivia family."
    }
  ],
  "notAdditionalGaps": [
    "Q012 andQ017 distinguish function evaluation from underdetermined unseen outputs; not merely duplicate wording.",
    "Q035 andQ036 distinguish a fully specified toy update from an unspecified network; retain both as complementary angles.",
    "Q037 andQ038 distinguish total action probability from latent branch identifiability.",
    "Q033 andQ058 share target arithmetic; the latter separately requires the home reward-column premise and must not inflate the number of numerical families.",
    "No additional numerical parameter variants are required merely to repeat eta/gamma arithmetic.",
    "Room names and decorative map furniture are contextual examples, not independently justified geometry/route problems.",
    "Unavailable research model weights or unseen safety plots cannot be invented or claimed executed."
